<Page x:Class="UniversalFtpServer.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:UniversalFtpServer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="_titleBlock"
                   x:Uid="MainPage_TitleBlock"
                   Margin="12"
                   Style="{StaticResource TitleTextBlockStyle}"/>
        <ScrollViewer Grid.Row="1">
            <RelativePanel x:Name="rootPanel"
                           Margin="6">
                <StackPanel x:Name="controlPanel"
                            Orientation="Vertical"
                            RelativePanel.AlignLeftWithPanel="True"
                            RelativePanel.AlignRightWithPanel="True"
                            RelativePanel.AlignTopWithPanel="True"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Margin="6">
                    <Grid Margin="6"
                          Padding="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Vertical"
                                    VerticalAlignment="Center">
                            <TextBlock x:Uid="MainPage_RootFolderHint"
                                       Margin="0,0,0,4"
                                       Text="Root folder-"/>
                            <TextBlock x:Name="rootFolderBlock"
                                       Margin="0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical"
                                    Grid.Column="2"
                                    VerticalAlignment="Bottom">
                            <Button x:Name="launchFolderButton"
                                    x:Uid="MainPage_LaunchFolderButton"
                                    Margin="0,0,0,4"
                                    HorizontalAlignment="Stretch"
                                    Click="LaunchFolderButton_Click"
                                    Content="Open folder-"/>
                            <Button x:Name="pickFolderButton"
                                    x:Uid="MainPage_ChangeFolderButton"
                                    HorizontalAlignment="Stretch"
                                    Click="PickFolderButton_Click"
                                    Content="Change folder-"/>
                        </StackPanel>
                    </Grid>
                    <NavigationViewItemSeparator/>
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="MainPage_PortLabel"
                                   Margin="6"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="portBox"
                                 x:Uid="MainPage_PortBox"
                                 Margin="6"
                                 Text="21"
                                 Grid.Column="1"/>
                    </Grid>
                    <NavigationViewItemSeparator/>
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="MainPage_AllowAnonymousLabel"
                                   Text="Anonymous access-"
                                   Margin="6"
                                   VerticalAlignment="Center"/>
                        <ToggleSwitch x:Name="_allowAnonymousToggle"
                                      Toggled="AllowAnonymousToggle_Toggled"
                                      Grid.Column="1"
                                      Margin="6"
                                      MinHeight="0"
                                      MinWidth="0"
                                      Padding="0"/>
                    </Grid>
                    <StackPanel Margin="6">
                        <TextBox x:Name="userNameBox"
                                 x:Uid="MainPage_UserNameBox"
                                 Margin="6"
                                 Header="User Name-"
                                 Text="ftp"/>
                        <TextBox x:Name="passwordBox"
                                 x:Uid="MainPage_PasswordBox"
                                 Margin="6"
                                 Header="Password-"
                                 Text="ftp"/>
                        <NavigationViewItemSeparator/>
                        <Button x:Name="startButton"
                                x:Uid="MainPage_StartButton"
                                Margin="6"
                                Click="StartButton_Click"
                                Content="Start-"/>
                        <Button x:Name="stopButton"
                                x:Uid="MainPage_StopButton"
                                Margin="6"
                                Click="StopButton_Click"
                                Content="Stop-"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="statusPanel"
                            Orientation="Vertical"
                            RelativePanel.AlignBottomWithPanel="True"
                            RelativePanel.AlignLeftWithPanel="True"
                            RelativePanel.AlignRightWithPanel="True"
                            RelativePanel.Below="controlPanel">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Uid="MainPage_AboutButton"
                                Margin="6"
                                Click="AboutButton_Click"/>
                        <Button x:Uid="MainPage_RateButton"
                                Margin="6"
                                Click="RateButton_Click"/>
                    </StackPanel>
                    <StackPanel Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Margin="6"
                                Padding="12,10">
                        <TextBlock x:Uid="MainPage_ImportantNotes_Para1"
                                   Margin="0,2"
                                   FontWeight="Bold"
                                   TextWrapping="WrapWholeWords">
                            MainPage_ImportantNotes_Para1-
                        </TextBlock>
                        <TextBlock x:Uid="MainPage_ImportantNotes_Para3"
                                   Margin="0,2"
                                   TextWrapping="WrapWholeWords">
                            MainPage_ImportantNotes_Para3-
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Margin="6"
                                Padding="12,10">
                        <TextBlock x:Uid="MainPage_ServerStatusHint"
                                   Margin="0,2"
                                   FontWeight="Bold"
                                   Text="Status-"/>
                        <TextBlock x:Name="statusBlock4"
                                   Margin="0,2"/>
                        <TextBlock x:Name="statusBlock6"
                                   Margin="0,2"/>
                    </StackPanel>
                    <StackPanel Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Margin="6"
                                Padding="12,10">
                        <TextBlock x:Uid="MainPage_AddressesHint"
                                   Margin="0,2"
                                   FontWeight="Bold"
                                   Text="Addresses of this computer-"/>
                        <TextBlock x:Name="addressesBlock"
                                   Margin="0,2"
                                   IsTextSelectionEnabled="True"/>
                    </StackPanel>
                    <StackPanel Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Margin="6"
                                Padding="12,10">
                        <TextBlock x:Uid="MainPage_LogsHint"
                                   Margin="0,2"
                                   FontWeight="Bold"
                                   Text="Logs:-"/>
                        <TextBlock x:Name="logsBlock"
                                   Margin="0,2"
                                   IsTextSelectionEnabled="True"/>
                    </StackPanel>
                </StackPanel>
            </RelativePanel>
        </ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="widthStateGroup">
                <VisualState x:Name="wideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="controlPanel.(RelativePanel.AlignRightWithPanel)"
                                Value="False"/>
                        <Setter Target="statusPanel.(RelativePanel.AlignLeftWithPanel)"
                                Value="False"/>
                        <Setter Target="statusPanel.(RelativePanel.AlignTopWithPanel)"
                                Value="True"/>
                        <Setter Target="statusPanel.(RelativePanel.Below)"
                                Value=""/>
                        <Setter Target="statusPanel.(RelativePanel.RightOf)"
                                Value="controlPanel"/>
                        <Setter Target="controlPanel.(FrameworkElement.Width)"
                                Value="400"/>
                        <Setter Target="rootPanel.Margin"
                                Value="18,6"/>
                        <Setter Target="_titleBlock.Margin"
                                Value="24,12"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="narrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1"/>
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="runningStateGroup">
                <VisualState x:Name="runningState">
                    <VisualState.Setters>
                        <Setter Target="pickFolderButton.(Control.IsEnabled)"
                                Value="False"/>
                        <Setter Target="startButton.(UIElement.Visibility)"
                                Value="Collapsed"/>
                        <Setter Target="stopButton.(UIElement.Visibility)"
                                Value="Visible"/>
                        <Setter Target="portBox.(Control.IsEnabled)"
                                Value="False"/>
                        <Setter Target="_allowAnonymousToggle.(Control.IsEnabled)"
                                Value="False"/>
                        <Setter Target="userNameBox.(Control.IsEnabled)"
                                Value="False"/>
                        <Setter Target="passwordBox.(Control.IsEnabled)"
                                Value="False"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="stoppedState"/>
            </VisualStateGroup>
            <VisualStateGroup x:Name="anonymousStateGroup">
                <VisualState x:Name="anonymousState">
                    <VisualState.Setters>
                        <Setter Target="userNameBox.IsEnabled"
                                Value="False"/>
                        <Setter Target="passwordBox.IsEnabled"
                                Value="False"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="notAnonymousState"/>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>